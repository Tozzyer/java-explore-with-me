    {
      "name": "Добавление категории",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Код должен быть 200 или 201\", function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "let json = {}; try { json = pm.response.json(); } catch(e) {}",
              "if (json && json.id) {",
              "  pm.collectionVariables.set(\"categoryId\", json.id);",
              "  console.log(\"ID новой категории:\", json.id);",
              "} else {",
              "  pm.collectionVariables.set(\"categoryId\", null);",
              "  console.error(\"ID категории не сохранён, ответ:\", pm.response.text());",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "body": { "mode": "raw", "raw": "{\"name\":\"music_events\"}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/admin/categories", "host": ["{{baseUrl}}"], "path": ["admin","categories"] }
      }
    },
    {
      "name": "Регистрация события",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Ожидаем 200 или 201\", function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "let json = {}; try { json = pm.response.json(); } catch(e) {}",
              "if (json && json.id) {",
              "  pm.collectionVariables.set(\"eventId\", json.id);",
              "  console.log(\"ID события:\", json.id);",
              "} else {",
              "  pm.collectionVariables.set(\"eventId\", null);",
              "  console.error(\"ID события не получен, ответ:\", pm.response.text());",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"annotation\": \"Краткая заметка о мероприятии.\",\n  \"category\": {{categoryId}},\n  \"description\": \"Тестовое описание для проверки работы.\",\n  \"eventDate\": \"2025-11-15 20:00:00\",\n  \"location\": { \"lat\": 55.7558, \"lon\": 37.6173 },\n  \"paid\": false,\n  \"participantLimit\": 120,\n  \"requestModeration\": false,\n  \"title\": \"Концерт в центре города\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/users/{{firstUserId}}/events", "host": ["{{baseUrl}}"], "path": ["users","{{firstUserId}}","events"] }
      }
    },
    {
      "name": "Админ публикует событие (статус: PENDING)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Возможны ответы: 200 (успешно) или 409 (уже опубликовано ранее)",
              "pm.test(\"Ожидаем код 200 или 409\", () => {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 409]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "body": { "mode": "raw", "raw": "{\"stateAction\":\"PUBLISH_EVENT\"}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/admin/events/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["admin","events","{{eventId}}"] }
      }
    },
    {
      "name": "PRIVATE: Пользователь А добавляет комментарий",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Допустимо: 201 (создан), 400 (ошибка данных), 404 (событие отсутствует)",
              "pm.test(\"Статус может быть 201, 400 или 404\", () => {",
              "  pm.expect(pm.response.code).to.be.oneOf([201, 400, 404]);",
              "});",
              "let json = {}; try { json = pm.response.json(); } catch(e) {}",
              "if (json && json.id) {",
              "  pm.collectionVariables.set(\"firstCommentId\", json.id);",
              "  console.log(\"Комментарий 1 создан с id:\", json.id);",
              "} else {",
              "  pm.collectionVariables.set(\"firstCommentId\", null);",
              "  console.error(\"Не удалось сохранить id комментария 1, ответ:\", pm.response.text());",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "body": { "mode": "raw", "raw": "{\n  \"text\": \"Комментарий от пользователя alex_1 для теста.\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/users/{{firstUserId}}/events/{{eventId}}/comments", "host": ["{{baseUrl}}"], "path": ["users","{{firstUserId}}","events","{{eventId}}","comments"] }
      }
    },
    {
      "name": "PRIVATE: Пользователь B добавляет комментарий",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Возможные коды: 201 (добавлено), 400 (валидация не пройдена), 404 (нет события)",
              "pm.test(\"Ожидаем 201, 400 или 404\", () => {",
              "  pm.expect(pm.response.code).to.be.oneOf([201, 400, 404]);",
              "});",
              "let json = {}; try { json = pm.response.json(); } catch(e) {}",
              "if (json && json.id) {",
              "  pm.collectionVariables.set(\"secondCommentId\", json.id);",
              "  console.log(\"Комментарий 2 создан с id:\", json.id);",
              "} else {",
              "  pm.collectionVariables.set(\"secondCommentId\", null);",
              "  console.error(\"Не удалось сохранить id комментария 2, ответ:\", pm.response.text());",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "body": { "mode": "raw", "raw": "{\n  \"text\": \"Тестовый комментарий от maria_2, проверка длины.\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/users/{{secondUserId}}/events/{{eventId}}/comments", "host": ["{{baseUrl}}"], "path": ["users","{{secondUserId}}","events","{{eventId}}","comments"] }
      }
    },
    {
      "name": "PUBLIC: Получить список комментариев к событию",
      "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/events/1/comments", "host": ["{{baseUrl}}"], "path": ["events","1","comments"] } }
    },
    {
      "name": "PUBLIC: Получить конкретный комментарий",
      "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/events/1/comments/1", "host": ["{{baseUrl}}"], "path": ["events","1","comments","1"] } }
    },

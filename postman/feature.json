              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "body": { "mode": "raw", "raw": "{\n  \"text\": \"обновлённый комментарий alex_1\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/users/{{firstUserId}}/events/{{eventId}}/comments/{{firstCommentId}}", "host": ["{{baseUrl}}"], "path": ["users","{{firstUserId}}","events","{{eventId}}","comments","{{firstCommentId}}"] }
      }

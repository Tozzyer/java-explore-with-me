      "request": {
        "method": "DELETE",
        "url": { "raw": "{{baseUrl}}/users/{{secondUserId}}/events/{{eventId}}/comments/{{firstCommentId}}", "host": ["{{baseUrl}}"], "path": ["users","{{secondUserId}}","events","{{eventId}}","comments","{{firstCommentId}}"] }
      }
    },
    {
      "name": "PRIVATE: Автор удаляет свой комментарий",
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["console.log('Удаляем комментарий id:', pm.collectionVariables.get('firstCommentId'));","pm.test(\"Код должен быть 204\", function () { pm.response.to.have.status(204); });"] }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": { "raw": "{{baseUrl}}/users/{{firstUserId}}/events/{{eventId}}/comments/{{firstCommentId}}", "host": ["{{baseUrl}}"], "path": ["users","{{firstUserId}}","events","{{eventId}}","comments","{{firstCommentId}}"] }
      }
    },
    {

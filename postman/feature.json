  "item": [
    {
      "name": "Регистрация пользователя №1",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Код ответа должен быть 200 или 201\", () => {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "let json = {}; try { json = pm.response.json(); } catch(e) {}",
              "if (json && json.id) {",
              "  pm.collectionVariables.set(\"firstUserId\", json.id);",
              "  console.log(\"Первый пользователь создан с id:\", json.id);",
              "} else {",
              "  pm.collectionVariables.set(\"firstUserId\", null);",
              "  console.error(\"Не удалось сохранить id первого пользователя, ответ:\", pm.response.text());",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"user_1\",\"email\":\"user_1@hotmail.com\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/admin/users", "host": ["{{baseUrl}}"], "path": ["admin","users"] }
      }
    },
    {
      "name": "Регистрация пользователя №2",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Код ответа должен быть 200 или 201\", () => {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",

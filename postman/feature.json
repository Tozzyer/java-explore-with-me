    {
      "name": "PRIVATE: Попытка изменения чужого комментария",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Проверка, что firstCommentId задан",
              "if (!pm.collectionVariables.get(\"firstCommentId\")) {",
              "  throw new Error(\"firstCommentId не задан. Убедись, что выполнен шаг 'Создание комментария пользователем 1'.\");",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Ожидаем статус 409\", () => {",
              "  pm.response.to.have.status(409);",
              "});",
              "let json = {};",
              "try { json = pm.response.json(); } catch (e) { json = {}; }",
              "pm.test(\"Ответ помечен как CONFLICT\", () => {",
              "  pm.expect(json).to.have.property(\"status\");",
              "  pm.expect(json.status).to.eql(\"CONFLICT\");",
              "  pm.expect(json).to.have.property(\"reason\");",
              "  pm.expect(String(json.reason || \"\").toLowerCase()).to.include(\"конфликт\");",
              "});",
              "pm.test(\"Сообщение указывает на чужой комментарий\", () => {",
              "  const msg = String(json.message || \"\").toLowerCase();",
              "  pm.expect(",
              "    msg.includes(\"не принадлежит пользователю\") ||",
              "    msg.includes(\"не матчится\") ||",
              "    msg.includes(\"не совпадает\") ||",
              "    msg.includes(\"чуж\")",
              "  ).to.eql(true);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Попытка изменить чужую запись, длина текста более 30 символов.\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/users/{{secondUserId}}/events/{{eventId}}/comments/{{firstCommentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["users", "{{secondUserId}}", "events", "{{eventId}}", "comments", "{{firstCommentId}}"]
        }
      },
      "response": []

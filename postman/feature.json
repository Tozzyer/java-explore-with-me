          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Должно вернуться сообщение об ошибке (чужой комментарий)\", () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.message).to.include(\"не принадлежит пользователю\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "body": { "mode": "raw", "raw": "{\n  \"text\": \"Попытка изменить чужую запись, длина текста более 30 символов.\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/users/{{secondUserId}}/events/{{eventId}}/comments/{{firstCommentId}}", "host": ["{{baseUrl}}"], "path": ["users","{{secondUserId}}","events","{{eventId}}","comments","{{firstCommentId}}"] }

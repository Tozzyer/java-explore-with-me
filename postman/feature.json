  "item": [
    {
      "name": "Регистрация пользователя А",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Ожидаем 200 или 201\", function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "let json = {}; try { json = pm.response.json(); } catch(e) {}",
              "if (json && json.id) {",
              "  pm.collectionVariables.set(\"firstUserId\", json.id);",
              "  console.log(\"ID первого созданного пользователя:\", json.id);",
              "} else {",
              "  pm.collectionVariables.set(\"firstUserId\", null);",
              "  console.error(\"ID первого пользователя не удалось установить, ответ:\", pm.response.text());",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"alex_1\",\"email\":\"alex_1@mail.com\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/admin/users", "host": ["{{baseUrl}}"], "path": ["admin","users"] }
      }
    },
    {
      "name": "Регистрация пользователя B",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Ожидаем 200 или 201\", function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",

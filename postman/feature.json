      "request": {
        "method": "PATCH",
        "body": { "mode": "raw", "raw": "{\n  \"text\": \"Администратор корректирует текст комментария (более 30 символов).\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/admin/events/{{eventId}}/comments/{{secondCommentId}}", "host": ["{{baseUrl}}"], "path": ["admin","events","{{eventId}}","comments","{{secondCommentId}}"] }

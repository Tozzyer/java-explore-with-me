  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "firstUserId", "value": "firstUser" },
    { "key": "secondUserId", "value": "secondUser" },
    { "key": "categoryId", "value": "category" },
    { "key": "eventId", "value": "event" },
    { "key": "firstCommentId", "value": "", "type": "string" },

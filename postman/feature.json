      "name": "PRIVATE: Автор редактирует свой комментарий",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Возможные ответы: 200 (обновлён), 400 (ошибка данных), 404 (не найдено), 409 (истёк срок редактирования)",
              "pm.test(\"Ожидаем 200, 400, 404 или 409\", () => {",
